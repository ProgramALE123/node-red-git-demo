    },
    {
        "id": "a110000000000022",
        "type": "function",
        "z": "a110000000000002",
        "name": "Generar respuesta según tipo",
        "func": "// Atiende el endpoint obligatorio y selecciona la respuesta desde ?tipo=consumo o ?tipo=ubicacion.\nconst tipo = msg.req && msg.req.query ? msg.req.query.tipo : 'consumo';\nif (tipo === 'ubicacion') {\n    msg.payload = {\n        laboratorio: 'Laboratorio de Redes',\n        bloque: 'Bloque de Ingeniería'\n    };\n    msg.statusCode = 200;\n} else if (tipo === 'consumo' || !tipo) {\n    msg.payload = {\n        sistema: 'Monitoreo Energético',\n        consumo_kwh: Math.round((1 + Math.random() * 14) * 10) / 10,\n        unidad: 'kWh'\n    };\n    msg.statusCode = 200;\n} else {\n    msg.payload = {error: 'Tipo de consulta no válido. Use consumo o ubicacion.'};\n    msg.statusCode = 400;\n}\nmsg.headers = {'Content-Type': 'application/json; charset=utf-8'};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 140,
        "wires": [
            [
                "a110000000000023"
            ]
        ],
        "info": "Servidor — si tipo=consumo genera aleatoriamente un valor de 1.0 a 15.0 kWh; si tipo=ubicacion devuelve laboratorio y bloque."
    },
