    {
        "id": "b440000000000001",
        "type": "function",
        "z": "a110000000000001",
        "name": "Preparar texto consumo",
        "func": "// Da formato a la respuesta del servidor para Dashboard y conserva JSON original para debug1.\nlet r = msg.payload;\nif (typeof r === 'string') {\n    try { r = JSON.parse(r); } catch (e) {\n        return [{payload: 'Respuesta inválida del servidor: ' + r}, msg];\n    }\n}\nif (!r || typeof r.consumo_kwh !== 'number') {\n    return [{payload: 'No se recibió un consumo válido. Revisa debug1.'}, msg];\n}\nconst vista = { payload: 'Consumo energético: ' + r.consumo_kwh.toFixed(1) + ' ' + (r.unidad || 'kWh') };\nreturn [vista, msg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 890,
        "y": 160,
        "wires": [
            [
                "b440000000000003"
            ],
            [
                "a110000000000014"
            ]
        ],
        "info": "Formatea el consumo para la página y reenvía la respuesta original a debug1."
    },
    {
        "id": "b440000000000002",
        "type": "function",
        "z": "a110000000000001",
        "name": "Preparar texto ubicación",
        "func": "// Da formato a laboratorio y bloque para Dashboard y conserva JSON original para debug2.\nlet r = msg.payload;\nif (typeof r === 'string') {\n    try { r = JSON.parse(r); } catch (e) {\n        return [{payload: 'Respuesta inválida del servidor: ' + r}, msg];\n    }\n}\nif (!r || !r.laboratorio || !r.bloque) {\n    return [{payload: 'No se recibieron laboratorio y bloque válidos. Revisa debug2.'}, msg];\n}\nconst vista = { payload: 'Laboratorio: ' + r.laboratorio + ' | Bloque: ' + r.bloque };\nreturn [vista, msg];",
