    {
        "id": "a110000000000021",
        "type": "http in",
        "z": "a110000000000002",
        "name": "GET API energético",
        "url": "/API/6toB/Alejandro",
        "method": "get",
        "upload": false,
        "swaggerDoc": "",
        "x": 160,
        "y": 140,
        "wires": [
            [
                "a110000000000022"
