        "name": "Encabezado visual",
        "order": 1,
        "width": 12,
        "height": 3,
        "head": "",
        "format": "<template>\n  <section class=\"energy-hero\">\n    <div class=\"hero-mark\">⚡</div>\n    <div class=\"hero-copy\">\n      <p class=\"eyebrow\">MONITOREO · API REST</p>\n      <h2>Monitoreo energético</h2>\n      <p>Consulta el consumo actual y la ubicación del laboratorio desde un solo panel.</p>\n    </div>\n    <div class=\"hero-badge\"><span class=\"pulse\"></span> CONSULTA EN TIEMPO REAL</div>\n  </section>\n</template>\n<style>\n.energy-hero{box-sizing:border-box;display:flex;align-items:center;gap:20px;flex-wrap:wrap;padding:24px 28px;border-radius:16px;background:linear-gradient(120deg,#063b43 0%,#087f8c 62%,#13a89a 100%);color:#fff;box-shadow:0 10px 28px rgba(8,79,87,.16);font-family:inherit}\n.hero-mark{width:56px;height:56px;display:grid;place-items:center;border-radius:16px;background:rgba(255,255,255,.16);font-size:30px}\n.hero-copy{flex:1;min-width:220px}.hero-copy .eyebrow{margin:0 0 5px;font-size:11px;letter-spacing:1.8px;font-weight:700;opacity:.78}.hero-copy h2{margin:0;font-size:25px;line-height:1.25;font-weight:700}.hero-copy p:last-child{margin:7px 0 0;font-size:14px;line-height:1.5;opacity:.88}\n.hero-badge{display:flex;align-items:center;gap:9px;padding:9px 13px;border:1px solid rgba(255,255,255,.32);border-radius:999px;background:rgba(255,255,255,.1);font-size:12px;font-weight:600;white-space:nowrap}\n.pulse{width:8px;height:8px;border-radius:50%;background:#75f0bc;box-shadow:0 0 0 4px rgba(117,240,188,.16)}\n@media(max-width:600px){.energy-hero{padding:19px;gap:14px}.hero-copy h2{font-size:21px}.hero-badge{margin-left:70px}}\n</style>",
